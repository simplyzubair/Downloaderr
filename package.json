{
  "name": "downloaderr",
  "version": "0.1.2",
  "description": "A Windows download manager with segmented transfers and browser video capture",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyzubair/Downloaderr.git"
  },
  "bugs": {
    "url": "https://github.com/simplyzubair/Downloaderr/issues"
  },
  "author": "Downloaderr contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs integration/*.test.cjs extension/*.test.cjs",
    "package": "electron-builder --win dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.18.1",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "com.awesomedownloader.desktop",
    "productName": "Downloaderr",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "simplyzubair",
        "repo": "Downloaderr",
        "releaseType": "release"
      }
    ],
    "files": [
      "desktop/**/*",
      "core/**/*",
      "renderer/**/*",
      "assets/**/*",
      "integration/**/*",
      "extension/**/*",
      "THIRD-PARTY.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
          "to": "licenses/FFmpeg-LICENSE.txt"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
          "to": "licenses/FFmpeg-BUILD.txt"
        },
        {
          "from": "vendor",
          "to": "tools",
          "filter": [
            "yt-dlp.exe",
            "*.txt"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Downloaderr-${version}-Windows.exe"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Downloaderr",
      "artifactName": "Downloaderr-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "licenses/ffmpeg-static-LICENSE.txt"
      },
      {
        "from": "node_modules/googlevideo/LICENSE",
        "to": "licenses/googlevideo-LICENSE.txt"
      },
      {
        "from": "extension",
        "to": "browser/extension",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "integration",
        "to": "browser/integration",
        "filter": [
          "native-host.exe",
          "native-host.cjs",
          "NativeHostLauncher.cs",
          "README.md",
          "register-native-host.ps1"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/app-icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "licenses/FFmpeg-LICENSE.txt"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.README",
          "to": "licenses/FFmpeg-BUILD.txt"
        }
      ],
      "artifactName": "Downloaderr-${version}-mac-arm64.${ext}"
    },
    "dmg": {
      "artifactName": "Downloaderr-${version}-mac-arm64.dmg"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^5.0.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  }
}
